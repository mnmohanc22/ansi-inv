#!/bin/bash
# CIS RHEL 9 Audit Runner
# Generated by Ansible on {{ ansible_date_time.iso8601 }}
# Host     : {{ inventory_hostname }}
# Checks   : {{ audit_manifest | length }}

set -o pipefail

SCRIPTS_DIR="{{ audit_work_dir }}/scripts"
CSV_FILE="{{ audit_csv_file }}"
HOSTNAME="{{ inventory_hostname }}"

PASSED=0
FAILED=0

printf '%s\n' "hostname,cis_id,description,result,output" > "${CSV_FILE}"

{% for check in audit_manifest %}
# -------------------------------------------------------
# {{ check.index + 1 }}/{{ audit_manifest | length }} | {{ check.cis_id }} | {{ check.description }}
# -------------------------------------------------------
OUTPUT=$(bash "${SCRIPTS_DIR}/{{ check.script }}" 2>&1)
RC=$?

if echo "${OUTPUT}" | grep -qiP '{{ check.expect }}'; then
    RESULT="PASS"
    PASSED=$(( PASSED + 1 ))
else
    RESULT="FAIL"
    FAILED=$(( FAILED + 1 ))
fi

OUTPUT_FLAT=$(printf '%s' "${OUTPUT}" | head -20 | tr '\n' '|' | sed 's/|*$//')
OUTPUT_FLAT="${OUTPUT_FLAT:0:800}"

printf '"%s","%s","%s","%s","%s"\n' \
    "${HOSTNAME}" \
    "{{ check.cis_id }}" \
    "{{ check.description | replace('"', '""') }}" \
    "${RESULT}" \
    "${OUTPUT_FLAT}" \
    >> "${CSV_FILE}"

printf '[%s] %s %s\n' "${RESULT}" "{{ check.cis_id }}" "{{ check.description }}"

{% endfor %}

printf '\n'
printf 'PASS  : %d\n' "${PASSED}"
printf 'FAIL  : %d\n' "${FAILED}"
printf 'TOTAL : %d\n' "$(( PASSED + FAILED ))"
printf 'CSV   : %s\n' "${CSV_FILE}"
